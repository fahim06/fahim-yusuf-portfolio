# ── Contact Form Email Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is in .gitignore and will NEVER be committed.

# Your Gmail address (the account that sends emails)
EMAIL_USER=your.gmail@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# How to generate one:
#   1. Visit https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already enabled
#   3. Search for "App passwords" in your Google Account settings
#   4. Create a new app password → select "Mail" + "Other (custom name)"
#   5. Copy the 16-character password here (no spaces)
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Where to receive contact form messages (optional, defaults to EMAIL_USER)
EMAIL_TO=your.gmail@gmail.com

# Vercel deployment token (only needed for CI/CD deployments)
# VERCEL_TOKEN=
